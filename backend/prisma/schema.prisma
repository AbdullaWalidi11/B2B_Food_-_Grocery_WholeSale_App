// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}


// ==========================================
// 1. CORE AUTH & IDENTITY
// ==========================================
enum UserRole {
  PLATFORM_ADMIN    // Manages platform, approves vendors
  VENDOR_ADMIN      // Distributor Owner (e.g., Wholesale Dairy Supplier)
  VENDOR_STAFF      // Distributor Employee (Driver, Sales Agent)
  BUYER_ADMIN       // Restaurant Owner / Chef (e.g., Lokanta Owner)
  BUYER_STAFF       // Restaurant Employee (Kitchen Assistant, Accountant)
}
model User {
  id              String        @id @default(uuid())
  email           String        @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole
  
  // Relations to scope users to their respective businesses
  vendorId        String?       // Populated if user is distributor staff
  vendor          Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  
  companyId       String?       // Populated if user is restaurant staff
  company         BuyerCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([vendorId])
  @@index([companyId])
}
// ==========================================
// 2. THE MULTI-TENANT ENTITIES
// ==========================================
model Vendor {
  id              String        @id @default(uuid())
  name            String        // e.g., "Marmara Gıda Toptan"
  taxNumber       String        @unique // Vergi Numarası
  taxOffice       String        // Vergi Dairesi
  isActive        Boolean       @default(false) // Platform admin approves them
  
  // Relations
  staff           User[]
  products        Product[]
  priceSheets     PriceSheet[]
  relationships   VendorCustomerRelationship[]
  orders          Order[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
model BuyerCompany {
  id              String        @id @default(uuid())
  name            String        // e.g., "Lezzet Lokantası"
  taxNumber       String        @unique
  taxOffice       String
  shippingAddress String
  billingAddress  String
  
  // Relations
  staff           User[]
  relationships   VendorCustomerRelationship[]
  orders          Order[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
// ==========================================
// 3. THE B2B CONTRACT RELATIONSHIP (Cari Hesap & Pricing)
// ==========================================
model VendorCustomerRelationship {
  id              String        @id @default(uuid())
  
  // Composite link: Defines how a unique Restaurant works with a unique Vendor
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  companyId       String
  company         BuyerCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Cari Hesap (Credit Management)
  creditLimit     Decimal       @default(0.00) @db.Decimal(12, 2) // Total debt limit allowed by vendor
  currentBalance  Decimal       @default(0.00) @db.Decimal(12, 2) // Outstanding unpaid debt
  netTermsDays    Int           @default(30)                     // Net 30, Net 15, etc.
  // The custom price book assigned to this specific restaurant by this vendor
  priceSheetId    String
  priceSheet      PriceSheet    @relation(fields: [priceSheetId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@unique([vendorId, companyId]) // A restaurant can only have one relationship with a vendor
  @@index([vendorId])
  @@index([companyId])
}
// ==========================================
// 4. CATALOG & DYNAMIC PRICING
// ==========================================
enum UnitOfMeasure {
  CASE       // Kasa (e.g., Tomatoes)
  SACK       // Çuval (e.g., Flour, Sugar)
  KILOGRAM   // Kg
  PIECE      // Adet
  BOX        // Koli
}
model Product {
  id              String        @id @default(uuid())
  vendorId        String        // Multi-tenant isolation: Every product belongs to one vendor
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  
  sku             String        // Stock Keeping Unit / Stock Code (e.g., FLOUR-001)
  name            String        // e.g., "Baklavalık Un"
  category        String        // e.g., "Bakliyat / Un"
  uom             UnitOfMeasure
  moq             Int           @default(1)                     // Minimum Order Quantity
  basePrice       Decimal       @db.Decimal(10, 2)              // Default wholesale price
  stockQuantity   Int           @default(0)
  // Relations
  priceSheetItems PriceSheetItem[]
  orderItems      OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@unique([vendorId, sku])     // SKUs must be unique within a vendor's catalog
  @@index([vendorId])
}
model PriceSheet {
  id              String        @id @default(uuid())
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name            String        // e.g., "Tier 1 Lokantalar", "VIP Cafes"
  // Relations
  items           PriceSheetItem[]
  relationships   VendorCustomerRelationship[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  @@index([vendorId])
}
model PriceSheetItem {
  id              String        @id @default(uuid())
  priceSheetId    String
  priceSheet      PriceSheet    @relation(fields: [priceSheetId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  contractedPrice Decimal       @db.Decimal(10, 2) // Custom negotiated price
  @@unique([priceSheetId, productId]) // One specific price per product per sheet
  @@index([priceSheetId])
}
// ==========================================
// 5. TRANSACTIONS & FULFILLMENT
// ==========================================
enum OrderStatus {
  PENDING_APPROVAL   // Waiting for restaurant manager approval
  SUBMITTED          // Sent to Vendor, checking credit
  PROCESSING         // Vendor preparing goods
  SHIPPED            // Out for delivery
  DELIVERED          // Completed
  CANCELLED
}
enum SnapshotAddress {
  SHIPPING
  BILLING
}
model Order {
  id              String          @id @default(uuid())
  companyId       String          // The restaurant making the purchase
  company         BuyerCompany    @relation(fields: [companyId], references: [id])
  
  vendorId        String          // The distributor fulfilling the order
  vendor          Vendor          @relation(fields: [vendorId], references: [id])
  status          OrderStatus     @default(SUBMITTED)
  totalAmount     Decimal         @db.Decimal(12, 2)
  
  shippingAddress SnapshotAddress @default(SHIPPING)
  invoiceUrl      String?         // Links to Supabase Storage PDF invoice
  items           OrderItem[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  @@index([companyId])
  @@index([vendorId])
}
model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  
  quantity        Int
  priceAtPurchase Decimal       @db.Decimal(10, 2) // Locked price snapshot at purchase
  createdAt       DateTime      @default(now())
  @@index([orderId])
}